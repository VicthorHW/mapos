# ============================================================
# MAPOS - PRODUÇÃO / RUNTIME
# ============================================================

# Configurações e secrets
/application/.env
/docker/.env

# Banco antigo em bind mount
/docker/data/

# ============================================================
# DEPENDÊNCIAS
# ============================================================

/vendor/
/application/vendor/

# ============================================================
# LOGS / CACHE / SESSÕES
# ============================================================

/application/logs/*
!/application/logs/index.html

/application/cache/*
!/application/cache/index.html

/ci_sessions/

# ============================================================
# ARQUIVOS GERADOS PELOS USUÁRIOS
# ============================================================

/assets/anexos/*
!/assets/anexos/index.html
!/assets/anexos/.gitkeep

/assets/arquivos/*
!/assets/arquivos/index.html
!/assets/arquivos/.gitkeep

/assets/uploads/*
!/assets/uploads/index.html
!/assets/uploads/.gitkeep

/assets/userImage/*
!/assets/userImage/index.html
!/assets/userImage/.gitkeep

# ============================================================
# AMBIENTES LOCAIS
# ============================================================

.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================================
# EDITORES / SISTEMA OPERACIONAL
# ============================================================

.DS_Store
desktop.ini
.vscode/
.idea/

.php_cs.cache
.php-cs-fixer.cache
